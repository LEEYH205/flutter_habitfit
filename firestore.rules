rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {



    /** ---------- 공통 헬퍼 함수 ---------- **/

    function signedIn() {

      return request.auth != null;

    }



    // 관리자 권한 확인 (Custom Claims 또는 특정 이메일)

    function isAdmin() {

      return signedIn() && (

        (request.auth.token.admin == true) ||

        (request.auth.token.role == "admin") ||

        (request.auth.token.email == "enoma20523@gmail.com")

      );

    }



    // 코치 권한 확인 (Custom Claims 또는 특정 이메일)

    function isCoach() {

      return signedIn() && (

        (request.auth.token.coach == true) ||

        (request.auth.token.role == "coach") ||

        (request.auth.token.email == "enoma20523@gmail.com")

      );

    }



    /** ---------- 관리자 전용 컬렉션 ---------- **/

    match /admin_promotions/{doc} {

      allow read, write: if isAdmin();

    }

    

    match /coach_promotions/{doc} {

      allow read, write: if isAdmin() || isCoach();

    }



    /** ---------- 사용자 프로필 (문서 ID = UID) ---------- **/

    match /users/{userId} {

      // 자신의 프로필 또는 친구 관계가 있는 경우 읽기 가능

      allow read: if isAdmin() || 

                    (signedIn() && (

                      request.auth.uid == userId ||

                      // 친구 관계 확인 (양방향) - 문서 ID 형식: userId_friendId

                      exists(/databases/$(database)/documents/friendships/$(userId + '_' + request.auth.uid)) ||

                      exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + userId))

                    ));

      // 쓰기는 자신의 프로필만

      allow write: if isAdmin() || (signedIn() && request.auth.uid == userId);

    }



    /** ---------- 사용자 레벨 (문서 ID = UID) ---------- **/

    match /user_levels/{userId} {

      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);

    }



    /** ---------- 사용자 패턴 분석 (문서 ID = UID) ---------- **/

    match /user_patterns/{userId} {

      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);

    }



    /** ---------- 사용자 개인 데이터 컬렉션 (uid 필드 기반) ---------- **/

    match /user_habits/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);

    }



    /** ---------- 사용자 포인트 (문서 ID = userId 또는 userId 필드 기반) ---------- **/

    match /user_points/{doc} {

      // 문서 ID가 userId인 경우 또는 문서 내 userId 필드 확인

      // 자신의 포인트 또는 친구 관계가 있는 경우 읽기 가능

      allow read: if isAdmin() || 

                    (signedIn() && (

                      doc == request.auth.uid ||

                      (resource != null && resource.data.userId == request.auth.uid) ||

                      // 친구 관계 확인 (양방향) - 문서 ID 형식: userId_friendId

                      exists(/databases/$(database)/documents/friendships/$(doc + '_' + request.auth.uid)) ||

                      exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + doc))

                    ));

      // 쓰기는 자신의 포인트만

      allow write: if isAdmin() || 

                     (signedIn() && (

                       doc == request.auth.uid ||

                       (resource != null && resource.data.userId == request.auth.uid)

                     ));

      allow create: if isAdmin() || 

                       (signedIn() && (

                         doc == request.auth.uid ||

                         request.resource.data.userId == request.auth.uid

                       ));

    }



    match /habit_completions/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);

    }



    /** ---------- 포인트 획득 기록 (userId 필드 기반) ---------- **/

    match /points_earned/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    match /workouts/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);

    }



    match /meals/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);

    }



    match /subscriptions/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    /** ---------- 업적 (문서 ID 형식: userId_achievementId 또는 userId 필드 기반) ---------- **/

    match /achievements/{doc} {

      // 문서 ID에서 userId 추출 (형식: userId_achievementId)
      function getUserIdFromDocId() {
        // 문서 ID에 '_'가 있으면 userId_achievementId 형식
        return doc.split('_')[0];
      }

      // 자신의 업적 읽기 가능 (문서 ID 또는 userId 필드 확인)
      allow read: if isAdmin() || 

                    (signedIn() && (

                      // 문서 ID 형식: userId_achievementId
                      getUserIdFromDocId() == request.auth.uid ||

                      // 또는 userId 필드 확인 (문서가 존재하는 경우)
                      (resource != null && resource.data.userId == request.auth.uid)

                    ));

      // 자신의 업적 쓰기 가능
      allow write: if isAdmin() || 

                     (signedIn() && (

                       // 문서 ID 형식: userId_achievementId
                       getUserIdFromDocId() == request.auth.uid ||

                       // 또는 userId 필드 확인 (문서가 존재하는 경우)
                       (resource != null && resource.data.userId == request.auth.uid)

                     ));

      // 자신의 업적 생성 가능
      allow create: if isAdmin() || 

                      (signedIn() && (

                        // 문서 ID 형식: userId_achievementId
                        getUserIdFromDocId() == request.auth.uid ||

                        // 또는 userId 필드 확인
                        request.resource.data.userId == request.auth.uid

                      ));

    }



    /** ---------- 업적 템플릿 (모든 사용자 읽기 가능, 관리자만 쓰기) ---------- **/

    match /achievement_templates/{doc} {

      allow read: if true; // 모든 사용자가 읽기 가능

      allow write: if isAdmin(); // 관리자만 쓰기 가능

    }



    /** ---------- 러닝 관련 컬렉션 (userId 필드 기반) ---------- **/

    match /running_events/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    match /running_coach_settings/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    match /training_plans/{doc} {

      allow read, write: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    /** ---------- 랭킹 시스템 (읽기 공개, 쓰기 제한) ---------- **/

    match /rankings/{doc} {

      allow read: if true; // 랭킹은 모든 사용자가 읽기 가능

      // 자신의 랭킹 데이터 생성 가능

      allow create: if isAdmin() || 

                      (signedIn() && (

                        request.resource.data.userId == request.auth.uid

                      ));

      // 자신의 랭킹 데이터 업데이트 가능 (.set() 메서드 사용 시에도 적용)

      allow update: if isAdmin() || 

                      (signedIn() && (

                        // 기존 문서의 userId가 자신의 것이고, 새 데이터의 userId도 자신의 것인지 확인

                        resource.data.userId == request.auth.uid &&

                        request.resource.data.userId == request.auth.uid

                      ));

      // 자신의 랭킹 데이터 삭제 가능

      allow delete: if isAdmin() || 

                      (signedIn() && resource.data.userId == request.auth.uid);

    }



    /** ---------- 친구 관계 (양방향 권한) ---------- **/

    match /friendships/{doc} {

      allow read: if isAdmin() || 

                    (signedIn() && (

                      resource.data.userId == request.auth.uid ||

                      resource.data.friendId == request.auth.uid

                    ));

      allow write: if isAdmin() || 

                     (signedIn() && (

                       (resource.data.userId == request.auth.uid && 

                        request.resource.data.userId == request.auth.uid) ||

                       (resource.data.friendId == request.auth.uid &&

                        request.resource.data.friendId == request.auth.uid)

                     ));

      allow create: if isAdmin() || 

                       (signedIn() && (

                         request.resource.data.userId == request.auth.uid ||

                         request.resource.data.friendId == request.auth.uid

                       ));

    }



    /** ---------- 클럽 시스템 ---------- **/

    match /clubs/{doc} {

      allow read: if true; // 클럽 정보는 공개

      allow write: if isAdmin() || 

                     (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);

    }



    match /club_members/{doc} {

      allow read: if isAdmin() || 

                     (signedIn() && resource.data.userId == request.auth.uid);

      allow write: if isAdmin();

      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);

    }



    /** ---------- 기본 거부 규칙 ---------- **/

    match /{document=**} {

      allow read, write: if false;

    }

  }

}
